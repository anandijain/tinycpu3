init: 
    steps = 4094 ; 0xffe
    ldi 0 
    sta steps

    n = 4092 ; 0xffc
    ldi 6
    sta n

    one = 4090 ; 0xffa
    ldi 1
    sta one

    three = 4088
    ldi 3 
    sta three

loop:
    lda n 
    ldb one
    jeq end

    lda steps
    add one
    sta steps

    lda n 
    and one
    jz even
    
odd: 
    lda n 
    mul three
    add one
    sta n
    jmp loop

even: 
    lda n 
    shr one
    sta n
    jmp loop

end: 
    lda steps
    hlt