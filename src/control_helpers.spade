use lib::Control;
use lib::AluOp;
use lib::BusSrc;

impl Default for Control{
    fn default() -> Self {
        Control {
            reg_we: false,
            write_sel:0,
            reg_sel: 0,

            u_we: false,
            v_we: false,
            alu_op: AluOp::Nop,

            pc_jmp: false,
            pc_inc: false,


            mar_we: false,
            mar_inc: false,


            instr_we: false,
            instr_step_rst: false,
            ram_hi_we: false,
            ram_lo_we: false,
            mem_hi_we: false, 
            bus_src: BusSrc::Nop,
            hlt: false,
            sp_push: false,
            sp_pop: false

        }
    }
}

